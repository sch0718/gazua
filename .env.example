# 동기화·공유(선택). VITE_SYNC_API_URL과 사용할 로그인 공급자 설정이 필요해요. 실제 값은 .env.local에 넣고 커밋하지 않아요.
# 자세한 순서: sync-worker/README.md
VITE_SYNC_API_URL=
VITE_FIREBASE_API_KEY=
# 배포 빌드는 앱 도메인(gazua.sch0718.dev). 로컬 개발 서버는 <프로젝트>.firebaseapp.com을 넣는다.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 카카오·네이버 로그인(선택). 공개 값이며, 값이 있는 공급자만 로그인 단추가 보여요.
# VITE_SYNC_API_URL과 아래 값만으로도 Firebase 없이 소셜 로그인·동기화를 쓸 수 있어요.
# 카카오 REST API 키(JavaScript 키와 달라요).
VITE_KAKAO_LOGIN_CLIENT_ID=
# 네이버 Client ID.
VITE_NAVER_LOGIN_CLIENT_ID=

# 로컬 개발 서버에서만 true로 켜요. 운영 빌드에서는 무시해요.
# corepack pnpm --filter sync-worker dev:social의 가짜 공급자로 로그인해요.
VITE_SOCIAL_DEV_MOCK=

# 카카오톡으로 공유 링크 보내기(선택). 비어 있으면 공유 대화상자에 링크 복사만 보여요.
# Kakao Developers 앱의 JavaScript 키. 플랫폼 › Web에 이 주소(로컬은 http://localhost:5173)를 등록해야 보낼 수 있어요.
VITE_KAKAO_JS_KEY=
