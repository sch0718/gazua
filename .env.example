# 동기화·공유(선택). 하나라도 비면 기능이 꺼진 채로 빌드돼요. 실제 값은 .env.local에 넣고 커밋하지 않아요.
# 자세한 순서: sync-worker/README.md
VITE_SYNC_API_URL=
VITE_FIREBASE_API_KEY=
# 배포 빌드는 앱 도메인(gazua.sch0718.dev). 로컬 개발 서버는 <프로젝트>.firebaseapp.com을 넣는다.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 카카오톡으로 공유 링크 보내기(선택). 비어 있으면 공유 대화상자에 링크 복사만 보여요.
# Kakao Developers 앱의 JavaScript 키. 플랫폼 › Web에 이 주소(로컬은 http://localhost:5173)를 등록해야 보낼 수 있어요.
VITE_KAKAO_JS_KEY=
