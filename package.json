{
  "name": "gazua",
  "private": true,
  "version": "0.7.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "universe": "node scripts/build-universe.mjs",
    "build:motion": "node scripts/build-motion.mjs",
    "build:share-images": "node scripts/build-share-images.mjs",
    "collect": "node scripts/collect-market-data.mjs",
    "prebuild": "node scripts/build-universe.mjs && node scripts/build-notices.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && svelte-check --tsconfig ./tsconfig.json",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "test": "TZ=America/New_York vitest run",
    "test:watch": "TZ=America/New_York vitest",
    "test:demo": "node --test tests/demo.test.mjs",
    "test:universe": "node --test tests/universe-reuse.test.mjs",
    "test:scripts": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "notices": "node scripts/build-notices.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sch0718/firebase-session": "0.2.1",
    "@sch0718/license-notices": "0.1.0",
    "@sch0718/motion-kit": "0.1.0",
    "@sch0718/ui-svelte": "0.1.0",
    "@sch0718/vite-app": "0.1.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "axe-core": "4.13.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^29",
    "playwright-core": "1.63.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@sch0718/kakao-share": "0.1.1",
    "@sch0718/seen-store": "0.1.0",
    "firebase": "^12.19.0",
    "idb": "^8.0.4",
    "lightweight-charts": "^5.2.1",
    "pretendard": "^1.3.9"
  }
}
