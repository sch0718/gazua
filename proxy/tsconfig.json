{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "node/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node/**/*.test.ts", "src/worker.ts"]
}
