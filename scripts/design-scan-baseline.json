[
  {
    "rule": "undersized-ui-text",
    "match": "^10px functional text \"(?:NXT|데모 데이터|데모 계좌예요)\"",
    "selector": "span\\.badge\\.(?:nxt|neutral)$",
    "class": "공용 패키지",
    "reason": "시범 4번: 공용 Badge의 10px 글자예요. WCAG에는 글자 크기 하한이 없고 세 저장소가 함께 써서 가즈아에서 덮지 않아요."
  },
  {
    "rule": "undersized-ui-text",
    "match": "^10px functional text \"(?:KRX|NXT)\"",
    "selector": "^small\\.svelte-[a-z0-9]+$",
    "screens": ["compare-example"],
    "class": "공용 패키지",
    "reason": "시범 5번: 공용 Segmented의 시장 보조 글자 10px이에요. Badge와 같은 이유로 덮지 않아요."
  },
  {
    "rule": "repeating-stripes-gradient",
    "match": "^repeating-gradient decorative stripes$",
    "screens": ["compare-example", "result", "performance"],
    "class": "오탐",
    "reason": "시범 6번: 차트 범례·차트의 빗금은 장식이 아니라 거래 불가·거래정지·단일가 구간 표시예요. 도구가 선택자를 body로만 줘서 화면으로 한정해요."
  },
  {
    "rule": "nested-cards",
    "match": "^Card inside card$",
    "selector": "^section\\.group\\.svelte-[a-z0-9]+$",
    "screens": ["editor", "editor-open", "result"],
    "class": "취향",
    "reason": "시범 7번: CondGroupCard 중첩은 묶음 안은 모두 만족, 묶음끼리는 또는인 구조를 보여 줘요(스펙 10.2)."
  },
  {
    "rule": "first-viewport-column-overflow",
    "match": "^div\\.sim\\.svelte-[a-z0-9]+\\.split opens the page",
    "screens": ["editor", "editor-open", "result"],
    "class": "오탐",
    "reason": "시범 8번: 데스크톱 시뮬레이션은 편집기와 결과를 나란히 두고, 실행 전 결과 칸은 짧은 게 맞아요."
  },
  {
    "rule": "flat-type-hierarchy",
    "match": "^Role sizes: body 13px, h3 13px, h2 15px",
    "screens": ["performance"],
    "class": "취향",
    "reason": "시범 9번: 성과 화면 제목 13·15px은 촘촘한 데이터 화면에 맞춘 크기예요."
  },
  {
    "rule": "tiny-text",
    "match": "^11px body text$",
    "selector": "^p\\.cmp-note\\.svelte-[a-z0-9]+$",
    "screens": ["templates"],
    "class": "취향",
    "reason": "2026-11-12 재실행: StrategyList 프리셋 비교 안내는 앱 라벨 토큰(--fs-label 11px)을 쓰는 보조 문구예요. 시범 3번(범례 11.5px)과 같아요."
  }
]
