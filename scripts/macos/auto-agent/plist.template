<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gazua.auto</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUN__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>XDG_CONFIG_HOME</key><string>__CONFIG_HOME__</string>
    <key>GAZUA_AUTO_NODE</key><string>__NODE__</string>
    <key>GAZUA_AUTO_ENV</key><string>__AUTO_ENV__</string>
    <key>GAZUA_AUTO_ALERT_ENV</key><string>__ALERT_ENV__</string>
  </dict>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
