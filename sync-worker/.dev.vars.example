# wrangler dev에서 쓸 로컬 비밀값 이름이다. .dev.vars에 값을 채워 넣고 커밋하지 않는다.
# wrangler dev에서만 .dev.vars 값이 wrangler.toml [vars]보다 우선한다.
# 포트는 앱 개발 서버에 맞추고, 콜백은 끝 슬래시까지 개발용 공급자 앱에 등록한 주소와 같아야 한다.
ALLOWED_ORIGINS=http://localhost:5173
SOCIAL_REDIRECT_URIS=http://localhost:5173/auth/callback/
# 허용 이메일과 공급자 계정은 콤마로 구분한다.
ALLOWED_EMAILS=
ALLOWED_ACCOUNTS=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
